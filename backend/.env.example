# --- Database ---
# PostgreSQL (production / local dev). Never commit real passwords.
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgresql+psycopg://aonontojahan:CHANGE_ME@localhost:5432/sms_db

# --- Auth / JWT ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_generate_a_long_random_string
REFRESH_SECRET_KEY=CHANGE_ME_generate_another_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# --- App ---
APP_NAME=School Management System
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENVIRONMENT=development
